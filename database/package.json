{
  "name": "@nextgen/database",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema, migrations, RLS policies, seeds and local dev cluster for NextGen ERP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "init": "node scripts/dev-db.mjs init",
    "start": "node scripts/dev-db.mjs start",
    "stop": "node scripts/dev-db.mjs stop",
    "status": "node scripts/dev-db.mjs status",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "purge:test-tenants": "tsx scripts/purge-test-tenants.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
