# Generated automatically by `npm run db:init` (database/scripts/dev-db.mjs).
# Local development only - never reuse these values in staging/production.
PG_BIN=C:/Program Files/PostgreSQL/18/bin
DEV_DB_PORT=5434
DEV_DB_SUPERUSER_PASSWORD=
# Owner role: owns tables, runs migrations (RLS does not apply to owner unless FORCEd)
DATABASE_OWNER_URL=postgres://nextgen_owner:<password>@127.0.0.1:5434/nextgen_erp
# App role: used by the backend at runtime, RLS enforced
DATABASE_URL=postgres://nextgen_app:<password>@127.0.0.1:5434/nextgen_erp
# Demo tenant admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=
