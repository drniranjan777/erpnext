# Copy to deploy/.env and fill in. Never commit the filled-in file.
NODE_ENV=production
TAG=latest
HTTP_PORT=3000

# Database: the owner role runs migrations; the app role is used at runtime (row-level security applies to it).
POSTGRES_OWNER_USER=nextgen_owner
POSTGRES_OWNER_PASSWORD=
DATABASE_OWNER_URL=postgres://nextgen_owner:<password>@postgres:5432/nextgen
DATABASE_URL=postgres://nextgen_app:<password>@postgres:5432/nextgen
# Optional streaming replica for reports and dashboards.
DATABASE_REPLICA_URL=

# Public address of the web app (used in emails and SSO redirects).
APP_URL=https://erp.example.in
DATA_REGION=ap-south-1 (Mumbai, India)

# Secrets: 32+ random characters each; DATA_ENCRYPTION_KEY is 32 random bytes, base64.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATA_ENCRYPTION_KEY=

# Email (SMTP URL); empty writes .eml files to MAIL_DIR instead.
SMTP_URL=
EMAIL_FROM=NextGen ERP <noreply@example.in>
PLATFORM_ADMIN_EMAILS=

# Optional providers
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
