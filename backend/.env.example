# Copy to .env. `npm run db:init` generates backend/.env automatically for local dev.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (used in invitation links)
APP_URL=http://localhost:3000
# Runtime DB role (RLS enforced) - never the owner/superuser
DATABASE_URL=postgres://nextgen_app:<password>@127.0.0.1:5434/nextgen_erp
# Attachment storage root (local dev)
STORAGE_DIR=./.storage
# Background job worker in this process (set false when running a dedicated worker)
WORKER_ENABLED=true
# Outbound email. Leave SMTP_URL empty in dev: emails are written to MAIL_DIR as .eml files.
SMTP_URL=
EMAIL_FROM=NextGen ERP <no-reply@nextgenerp.in>
MAIL_DIR=./.mail
# WhatsApp: log (dev) | disabled
WHATSAPP_PROVIDER=log
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DATA_ENCRYPTION_KEY=
# Emails allowed into the platform super-admin console
PLATFORM_ADMIN_EMAILS=
# Billing: mock (built-in test checkout) | razorpay
BILLING_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# {"growth:monthly":"plan_xxx","growth:yearly":"plan_yyy",...}
RAZORPAY_PLAN_IDS={}
SAAS_SELLER_NAME=NextGen ERP Technologies Pvt Ltd
SAAS_SELLER_GSTIN=
SAAS_SELLER_STATE_CODE=36
SAAS_SELLER_ADDRESS=
# Development only: let webhooks call localhost/private IPs
WEBHOOKS_ALLOW_PRIVATE=false
